{
    "Purchase Order": [
        {
            "fieldname": "brn",
            "fieldtype": "Link",
            "insert_after": "schedule_date",
            "label": "BRN",
            "options": "BRN",
            "read_only": 0,
            "reqd": 0,
            "hidden": 0,
            "module": "Settlement"
        },
        {
            "fieldname": "requisition_type",
            "fieldtype": "Select",
            "insert_after": "brn",
            "label": "Requisition Type",
            "options": "\nService\nFixed Asset\nMaterial",
            "fetch_from": "brn.requisition_type",
            "read_only": 1,
            "module": "Settlement"
        },
        {
            "fieldname": "validity_start_date",
            "fieldtype": "Date",
            "insert_after": "requisition_type",
            "label": "Validity Start Date",
            "module": "Settlement",
            "depends_on": "eval:(doc.brn || doc.po_type=='PO Based')"
        },
        {
            "fieldname": "validity_end_date",
            "fieldtype": "Date",
            "insert_after": "validity_start_date",
            "label": "Validity End Date",
            "module": "Settlement",
            "depends_on": "eval:(doc.brn || doc.po_type=='PO Based')"
        },
        {
            "fieldname": "custom_fiscal_year",
            "fieldtype": "Link",
            "insert_after": "validity_end_date",
            "label": "Fiscal Year",
            "options": "Fiscal Year",
            "module": "Settlement"
        },
        {
            "default": "0",
            "fieldname": "apply_tds",
            "fieldtype": "Check",
            "label": "Apply Tax Withholding Amount",
            "insert_after": "company",
            "module": "Settlement"
        },
        {
            "depends_on": "eval:(doc.apply_tds)",
            "fieldname": "tax_withholding_category",
            "fieldtype": "Link",
            "label": "Tax Withholding Category",
            "options": "Tax Withholding Category",
            "insert_after": "apply_tds",
            "module": "Settlement"
        },
        {
            "fieldname": "tax_withholding_entries",
            "fieldtype": "Table",
            "options": "Tax Withholding Entry",
            "insert_after": "taxes",
            "label": "Tax Withholding Entries",
            "read_only": 1,
            "no_copy": 1,
            "module": "Settlement"
        },
        {
            "fieldname": "apply_tds",
            "fieldtype": "Check",
            "insert_after": "company",
            "label": "Apply Tax Withholding Amount",
            "no_copy": 1,
            "module": "Settlement"
        }
    ]
}
