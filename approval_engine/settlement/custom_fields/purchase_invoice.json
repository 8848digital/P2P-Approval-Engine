{
    "Purchase Invoice": [
        {
            "dt": "Purchase Invoice",
            "fieldname": "brn",
            "fieldtype": "Link",
            "insert_after": "is_related_party_transaction",
            "label": "BRN",
            "module": "Settlement",
            "options": "BRN",
            "read_only": 0,
            "reqd": 0,
            "lenght": 20
        },
        {
            "fieldname": "requisition_type",
            "fieldtype": "Select",
            "insert_after": "brn",
            "label": "Requisition Type",
            "options": "\nService\nFixed Asset\nMaterial",
            "fetch_from": "brn.requisition_type",
            "read_only": 1,
            "length": 15,
            "module": "Settlement"
        },
        {
            "fieldname": "validity_start_date",
            "fieldtype": "Date",
            "insert_after": "requisition_type",
            "label": "Validity Start Date",
            "module": "Settlement",
            "depends_on": "eval:(doc.brn)"
        },
        {
            "fieldname": "validity_end_date",
            "fieldtype": "Date",
            "insert_after": "validity_start_date",
            "label": "Validity End Date",
            "module": "Settlement",
            "depends_on": "eval:(doc.brn)"
        },
        {
            "fieldname": "custom_allowance_consumed_amount",
            "fieldtype": "Currency",
            "label": "Allowance Consumed Amount (internal)",
            "insert_after": "apply_tds",
            "hidden": 1,
            "read_only": 1,
            "no_copy": 1,
            "description": "Set by update_supplier_allowance_consumed on submit - the exact amount this invoice added to the supplier's Consumed Amount (capped at the Allowance Limit, so this can be less than the invoice's own TDS-applicable total). cancel_supplier_allowance_consumed reverses exactly this amount, not a recomputed one, so capping doesn't drift the balance on cancel.",
            "module": "Settlement"
        },
        {
            "fieldname": "custom_supplier_invoice_copy",
            "fieldtype": "Attach",
            "insert_after": "bill_date",
            "label": "Supplier Invoice Copy",
            "module": "Settlement"
        },
        {
            "fieldname": "custom_fiscal_year",
            "fieldtype": "Link",
            "insert_after": "title",
            "label": "Fiscal Year",
            "module": "Settlement",
            "options": "Fiscal Year"
        },
        {
            "fieldname": "msa_agreement",
            "fieldtype": "Check",
            "insert_after": "validity_end_date",
            "label": "MSA Agreement",
            "read_only": 1,
            "allow_on_submit": 1,
            "description": "If MSA is not attached, payment will be blocked.",
            "module": "Settlement"
        },
        {
            "dt": "Purchase Invoice",
            "fieldname": "is_itc_reversed",
            "fieldtype": "Check",
            "label": "ITC Reversed",
            "insert_after": "bill_date",
            "read_only": 1,
            "print_hide": 1,
            "no_copy": 1,
            "module": "Settlement"
        }
    ]
}
