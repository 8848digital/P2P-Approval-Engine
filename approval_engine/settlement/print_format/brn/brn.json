 "css": ".print-format td, .print-format th {\n    padding: 5px !important;\n}\n\n.table-header td {\n    text-align: center;\n    font-size: 12px;\n    border-right: 1px solid black;\n    padding: 4px;\n}",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "BRN",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<head>\n  <meta charset=\"UTF-8\">\n</head>\n<body>\n  <table style=\"width: 100%; border-collapse: collapse; border: 1px solid black;\">\n    <tr>\n      <td style=\"width: 80%; vertical-align: middle !important; font-size: 18px; font-weight: bold; text-align: left;\">\n        {{ doc.company }}\n      </td>\n      <td style=\"text-align: center;\">\n        <img src=\"/private/files/Gold logo (1) (1).png\" height=\"60px\" width=\"60px\">\n      </td>\n    </tr>\n  </table>\n\n  <table style=\"width: 100%; border-collapse: collapse; border: 1px solid black; border-top: none;\">\n    <tr>\n      <td colspan=\"2\" style=\"text-align: center; font-weight: bold; font-size: 14px; border-bottom: 1px solid black;\">\n        {{ doc.doctype }}\n      </td>\n    </tr>\n    <tr>\n        <td style=\"width: 50%; border-right: 1px solid black; padding: 6px; font-size: 12px;\">\n            <table style=\"width: 100%; border-collapse: collapse; font-size: 12px;\">\n                <tr>\n                    <td style=\"width: 50%; font-weight: bold;\">Posting Date</td>\n                    <td>: {{ frappe.utils.format_date(doc.transaction_date, \"dd-MMM-yyyy\") }}</td>\n                </tr>\n                <tr>\n                    <td style=\"font-weight: bold;\">Purpose</td>\n                    <td>: {{ doc.material_request_type }}</td>\n                </tr>\n                <tr>\n                    <td style=\"font-weight: bold;\">Requisition Type</td>\n                    <td>: {{ doc.requisition_type }}</td>\n                </tr>\n                {%- if doc.is_new_vendor -%}\n                    <tr>\n                        <td style=\"font-weight: bold;\">Is New Vendor</td>\n                        <td>: Yes</td>\n                    </tr>\n                    <tr>\n                        <td style=\"font-weight: bold;\">Vendor</td>\n                        <td>: {{doc.new_vendor or \"\"}}</td>\n                    </tr>\n                {%- endif -%}\n                {%- if doc.is_existing_vendor -%}\n                    <tr>\n                        <td style=\"font-weight: bold;\">Is Existing Vendor</td>\n                        <td>: Yes</td>\n                    </tr>\n                    <tr>\n                        <td style=\"font-weight: bold;\">Vendor</td>\n                        <td>: {{doc.existing_vendor or \"\"}}</td>\n                    </tr>\n                {%- endif -%}\n            </table>\n        </td>\n        <td style=\"width: 50%; border-right: 1px solid black; padding: 6px; font-size: 12px;\">\n            <table style=\"width: 100%; border-collapse: collapse; font-size: 12px;\">\n                <tr>\n                    <td style=\"width: 60%; font-weight: bold;\">BRN</td>\n                    <td>: {{ doc.name or \"\" }}</td>\n                </tr>\n                <tr>\n                    <td style=\"width: 60%; font-weight: bold;\">Duration of Service In Months</td>\n                    <td>: {{ doc.duration_of_service_months or \"\" }}</td>\n                </tr>\n                <tr>\n                    <td style=\"font-weight: bold;\">Service Start Date</td>\n                    <td>: {{ frappe.utils.format_date(doc.service_start_date, \"dd-MMM-yyyy\") or \"\" }}</td>\n                </tr>\n                <tr>\n                    <td style=\"font-weight: bold;\">Expiry Date</td>\n                    <td>: {{ frappe.utils.format_date(doc.expiry_date, \"dd-MMM-yyyy\") or \"\" }}</td>\n                </tr>\n            </table>\n        </td>\n    </tr>\n  </table>\n  <table style=\"width: 100%; border-collapse: collapse; border: 1px solid black; border-top: none;\">\n      <tr class=\"table-header\">\n        <td style=\"width: 10%;background-color: #f2f2f2;font-weight: bold;\">Sr No.</td>\n        <td style=\"width: 20%;background-color: #f2f2f2;font-weight: bold;\">Item Code</td>\n        <td style=\"width: 25%;background-color: #f2f2f2;font-weight: bold;\">Description</td>\n        <td style=\"width: 10%;background-color: #f2f2f2;font-weight: bold;\">Qty</td>\n        <td style=\"width: 15%;background-color: #f2f2f2;font-weight: bold;\">Rate</td>\n        <td style=\"width: 20%;background-color: #f2f2f2;font-weight: bold;\">Amount</td>\n      </tr>\n      {%- for row in doc.items -%}\n        <tr class=\"table-header\">\n            <td style=\"width: 10%;border-top: 1px solid black;\">{{ row.idx or \"\"}}</td>\n            <td style=\"width: 20%;border-top: 1px solid black;\">{{ row.item_code or \"\" }}</td>\n            <td style=\"width: 25%;border-top: 1px solid black;\">{{ row.description or \"\" }}</td>\n            <td style=\"width: 10%;border-top: 1px solid black;\">{{ row.qty or \"\" }}</td>\n            <td style=\"width: 15%;border-top: 1px solid black;\">{{ row.rate or \"\" }}</td>\n            <td style=\"width: 20%;border-top: 1px solid black;\">{{ row.amount or \"\" }}</td>\n        </tr>\n      {%- endfor -%}\n      <tr>\n        <td colspan=\"5\" style=\"text-align: right; font-weight: bold; border-top: 1px solid black; padding: 4px;\">\n          Total Amount :\n        </td>\n        <td style=\"text-align: center; font-weight: bold; border-top: 1px solid black; padding: 4px;\">\n          {{ doc.total_amount or \"\" }}\n        </td>\n      </tr>\n  </table>\n</body>\n",
