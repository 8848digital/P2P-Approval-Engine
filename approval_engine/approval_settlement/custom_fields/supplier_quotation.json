{
    "Supplier Quotation": [
        {
            "dt": "Supplier Quotation",
            "fieldname": "custom_brn",
            "fieldtype": "Link",
            "insert_after": "auto_repeat",
            "label": "BRN",
            "options": "BRN",
            "read_only": 1,
            "no_copy": 1,
            "module": "Approval Settlement"
        },
        {
            "dt": "Supplier Quotation",
            "fieldname": "duration_of_service_months",
            "fieldtype": "Int",
            "insert_after": "quotation_number",
            "label": "Duration of Service (Months)",
            "non_negative": 1,
            "reqd": 0,
            "default": "",
            "read_only": 0,
            "description": "Enter The Duration In Numbers",
            "hidden": 0,
            "module": "Approval Settlement"
        },
        {
            "dt": "Supplier Quotation",
            "fieldname": "is_new_vendor",
            "fieldtype": "Check",
            "insert_after": "duration_of_service_months",
            "label": "Is New Vendor",
            "non_negative": 0,
            "reqd": 0,
            "default": "",
            "read_only": 0,
            "hidden": 0,
            "module": "Approval Settlement"
        },
        {
            "dt": "Supplier Quotation",
            "fieldname": "is_existing_vendor",
            "fieldtype": "Check",
            "insert_after": "is_new_vendor",
            "label": "Is Existing Vendor",
            "hidden": 0,
            "module": "Approval Settlement"
        },
        {
            "dt": "Supplier Quotation",
            "fieldname": "new_vendor",
            "fieldtype": "Data",
            "insert_after": "msa_agreement",
            "label": "Vendor",
            "depends_on": "eval:(doc.is_new_vendor == 1)",
            "mandatory_depends_on": "eval:(doc.is_new_vendor == 1)",
            "reqd": 0,
            "read_only": 0,
            "hidden": 0,
            "module": "Approval Settlement"
        },
        {
            "dt": "Supplier Quotation",
            "fieldname": "msa_agreement",
            "fieldtype": "Check",
            "insert_after": "is_new_vendor",
            "label": "MSA Agreement",
            "fetch_from": "existing_vendor.custom_msa_agreement",
            "reqd": 0,
            "read_only": 0,
            "hidden": 0,
            "module": "Approval Settlement"
        },
        {
            "dt": "Supplier Quotation",
            "fieldname": "service_start_date",
            "fieldtype": "Date",
            "insert_after": "msa_agreement",
            "label": "Service Start Date",
            "reqd": 0,
            "read_only": 0,
            "hidden": 0,
            "module": "Approval Settlement"
        },
        {
            "dt": "Supplier Quotation",
            "fieldname": "custom_vendor_email",
            "fieldtype": "Data",
            "insert_after": "service_start_date",
            "label": "Vendor Email",
            "read_only": 0,
            "no_copy": 0,
            "allow_on_submit": 0,
            "module": "Approval Settlement"
        },
        {
            "dt": "Supplier Quotation",
            "fieldname": "custom_requisition_id",
            "fieldtype": "Select",
            "insert_after": "cost_center",
            "label": "Requisition ID",
            "options": "\nNew Requisition\nExisting Requisition",
            "read_only": 0,
            "no_copy": 0,
            "allow_on_submit": 1,
            "module": "Approval Settlement"
        },
        {
            "dt": "Supplier Quotation",
            "fieldname": "custom_requisition_no",
            "fieldtype": "Link",
            "insert_after": "custom_requisition_id",
            "label": "Requisition No",
            "options": "Requisition ID",
            "read_only": 0,
            "no_copy": 0,
            "allow_on_submit": 1,
            "module": "Approval Settlement"
        }
    ]
}
